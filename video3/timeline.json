  {
   "id": "kneel",
   "start": 42.873673469387754,
   "end": 65.77038276643991,
   "sents": [
    {
     "who": "h",
     "text": "My God, my God, why have you forsaken me? Why are you so far from helping me, and from the words of my groaning?",
     "label": "PSALM 22  \u00b7  WORLD ENGLISH BIBLE",
     "tag": "ps1",
     "start": 45.27367346938775,
     "end": 52.37897959183673,
     "file": "audio/06_kneel.wav"
    },
    {
     "who": "h",
     "text": "My God, I cry in the daytime, but you don't answer; in the night season, and am not silent.",
     "label": "PSALM 22  \u00b7  WORLD ENGLISH BIBLE",
     "tag": "ps2",
     "start": 52.87897959183673,
     "end": 58.77684807256236,
     "file": "audio/07_kneel.wav"
    },
    {
     "who": "h",
     "text": "But you are holy, you who inhabit the praises of Israel.",
     "label": "PSALM 22  \u00b7  WORLD ENGLISH BIBLE",
     "tag": "ps3",
     "start": 59.27684807256236,
     "end": 62.73662131519274,
     "file": "audio/08_kneel.wav"
    },
    {
     "who": "h",
     "text": "Our fathers trusted in you. They trusted, and you delivered them.",
     "label": "PSALM 22  \u00b7  WORLD ENGLISH BIBLE",
     "tag": "ps4",
     "start": 63.23662131519274,
     "end": 65.77038276643991,
     "file": "audio/09_kneel.wav"
    }
   ]
  },
  {
