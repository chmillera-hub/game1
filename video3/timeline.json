   "start": 93.5440925170068,
   "end": 109.38701768707485,
   "sents": [
    {
     "who": "as",
     "text": "Did they know that I love them?",
     "label": null,
     "tag": "s1",
     "start": 95.39409251700681,
     "end": 96.54348027210885,
     "file": "audio/14_alone.wav"
    },
    {
     "who": "as",
     "text": "Surely such as these will have tribulation in this world... but fear not... I have overcome the world.",
