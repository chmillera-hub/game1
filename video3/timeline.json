  {
   "id": "kneel",
   "start": 42.606643990929705,
   "end": 68.98402448979591,
   "sents": [
    {
     "who": "h",
     "text": "My God, my God, why hast thou forsaken me? Why art thou so far from helping me, and from the words of my roaring?",
     "label": "PSALM 22",
     "tag": "ps1",
     "start": 45.0066439909297,
     "end": 53.02913832199546,
     "file": "audio/06_kneel.wav"
    },
    {
     "who": "h",
     "text": "O my God, I cry in the daytime, but thou hearest not; and in the night season, and am not silent.",
     "label": "PSALM 22",
     "tag": "ps2",
     "start": 53.52913832199546,
     "end": 60.6460544217687,
     "file": "audio/07_kneel.wav"
    },
    {
     "who": "h",
     "text": "But thou art holy, O thou that inhabitest the praises of Israel.",
     "label": "PSALM 22",
     "tag": "ps3",
     "start": 61.1460544217687,
     "end": 65.66233560090703,
     "file": "audio/08_kneel.wav"
    },
    {
     "who": "h",
     "text": "Our fathers trusted in thee: they trusted, and thou didst deliver them.",
     "label": "PSALM 22",
     "tag": "ps4",
     "start": 66.16233560090703,
     "end": 68.98402448979591,
     "file": "audio/09_kneel.wav"
    }
   ]
  },
  {
