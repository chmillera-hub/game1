  },
  {
   "id": "thermal",
   "start": 72.59926258503401,
   "end": 93.5440925170068,
   "sents": [
    {
     "who": "n",
     "text": "The android turns. In the dark, nothing is hidden from those eyes.",
     "label": null,
     "tag": "th1",
     "start": 73.94926258503402,
     "end": 78.99960272108844,
     "file": "audio/11_thermal.wav"
    },
    {
     "who": "n",
     "text": "Heat vision. A racing pulse. A trembling human, vulnerable and afraid.",
     "label": null,
     "tag": "th2",
     "start": 79.49960272108844,
     "end": 85.00273197278912,
     "file": "audio/12_thermal.wav"
    },
    {
     "who": "n",
     "text": "Slowly, they back away, certain they've been caught, and hoping to be spared.",
     "label": null,
     "tag": "th3",
     "start": 85.60273197278912,
     "end": 90.44409251700681,
     "file": "audio/13_thermal.wav"
    },
    {
     "who": "silence",
     "text": "",
     "tag": "leave",
     "start": 90.44409251700681,
     "end": 93.0440925170068,
     "file": null
    }
   ]
  },
  {
