   "sents": [
    {
     "who": "n",
     "text": "Deep in a grand old mansion, a library glows in the last light of a dying fire.",
     "label": null,
     "tag": "n_room1",
     "start": 8.245850340136053,
     "end": 13.981179138321995,
     "file": "audio/01_room.wav"
    },
    {
     "who": "n",
     "text": "In a leather chair, an android sits perfectly still, watching the flames.",
     "label": null,
     "tag": "n_room2",
     "start": 14.381179138321995,
     "end": 19.385079365079363,
     "file": "audio/02_room.wav"
