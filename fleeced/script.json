{
  "title": "FLEECED",
  "subtitle": "a parable about tokens",
  "fps": 30,
  "defaults": { "lead": 0.35, "gap": 0.25, "hold": 0.6 },
  "lexicon": { "bleating": "blˈiːt ɪŋ" },

  "speakers": {
    "narrator": { "voice": "am_michael", "speed": 1.0, "level": -19, "color": "#ffffff" },
    "farmer":   { "voice": "bm_george", "speed": 0.94, "level": -19, "color": "#ffd166", "name": "Farmer" },
    "sheepA":   { "voice": "af_bella", "speed": 1.0, "level": -20, "color": "#bfe9ff", "name": "Sheep",
                  "fx": { "pitch": 1.16, "vibrato": [7.0, 0.5], "tremolo": [7.0, 0.35] } },
    "sheepB":   { "voice": "am_puck", "speed": 1.0, "level": -20, "color": "#bfe9ff", "name": "Sheep",
                  "fx": { "pitch": 1.28, "vibrato": [7.5, 0.55], "tremolo": [7.5, 0.35] } },
    "sheepC":   { "voice": "af_sky", "speed": 1.0, "level": -20, "color": "#bfe9ff", "name": "Sheep",
                  "fx": { "pitch": 1.2, "vibrato": [6.5, 0.5], "tremolo": [6.5, 0.35] } },
    "poor":     { "voice": "af_nicole", "speed": 0.95, "level": -17, "color": "#d9d2c3", "name": "Poor sheep",
                  "fx": { "pitch": 1.1, "vibrato": [6.0, 0.32], "tremolo": [6.0, 0.2] } },
    "phar1":    { "voice": "bm_fable", "speed": 1.0, "level": -18, "color": "#ffb347", "name": "Pharisee sheep",
                  "fx": { "pitch": 0.97, "vibrato": [6.0, 0.3], "tremolo": [6.0, 0.22] } },
    "phar2":    { "voice": "am_fenrir", "speed": 1.0, "level": -18, "color": "#ffb347", "name": "Pharisee sheep",
                  "fx": { "pitch": 0.92, "vibrato": [6.5, 0.35], "tremolo": [6.5, 0.25] } }
  },

  "scenes": [
    {
      "id": "title", "lead": 0, "minDur": 4.6, "music": "farm",
      "cues": [
        { "id": "titleDrop", "sfx": "whoosh", "t": 0.25, "gain": -8 },
        { "id": "titleLand", "sfx": "thump", "t": 0.7, "gain": -6 },
        { "id": "titleSub", "t": 1.5 },
        { "id": "titlePan", "t": 3.0 }
      ],
      "lines": []
    },

    {
      "id": "farm", "lead": 0.15, "hold": 1.4, "music": "farm",
      "lines": [
        { "id": "n_bruh", "who": "narrator", "text": "Bruh.", "gap": 0 },
        { "id": "n_imagine", "who": "narrator", "text": "Imagine being a farmer,", "gap": 0.45,
          "cues": [ { "id": "farmerPop", "sfx": "boing", "t": -0.45, "from": "end", "gain": -6 } ] },
        { "id": "n_sheep", "who": "narrator", "text": "and you have a bunch of sheep.", "gap": 0.35,
          "cues": [
            { "id": "sheepPop1", "sfx": "pop", "t": -0.7, "from": "end", "gain": -8, "pan": -0.5 },
            { "id": "sheepPop2", "sfx": "pop", "t": -0.52, "from": "end", "gain": -8, "pan": 0.4 },
            { "id": "sheepPop3", "sfx": "pop", "t": -0.34, "from": "end", "gain": -8, "pan": -0.2 },
            { "id": "sheepPop4", "sfx": "pop", "t": -0.16, "from": "end", "gain": -8, "pan": 0.6 },
            { "id": "sheepPop5", "sfx": "pop", "t": 0.02, "from": "end", "gain": -8, "pan": -0.7 },
            { "id": "sheepPop6", "sfx": "pop", "t": 0.2, "from": "end", "gain": -8, "pan": 0.2 },
            { "id": "sheepBaa", "sfx": "bleat_chorus", "t": 0.45, "from": "end", "gain": -9 }
          ] }
      ]
    },

    {
      "id": "tokens", "lead": 0.3, "hold": 0.7, "music": "farm",
      "lines": [
        { "id": "n_tell", "who": "narrator", "text": "And then you tell the sheep...", "gap": 0 },
        { "id": "f_giving", "who": "farmer", "text": "Sheep! I'm giving you tokens!", "gap": 0.35,
          "cues": [ { "id": "tokenUp", "sfx": "shine", "t": -0.55, "from": "end", "gain": -8 },
                    { "id": "tokensRain", "sfx": "coins_rain", "t": 0.25, "from": "end", "gain": -9 } ] },
        { "id": "f_food", "who": "farmer", "text": "You use these tokens to buy food,", "gap": 1.25,
          "cues": [ { "id": "iconFood", "sfx": "pop", "t": -0.35, "from": "end", "gain": -9 } ] },
        { "id": "f_shelter", "who": "farmer", "text": "and to pay for shelter.", "gap": 0.15,
          "cues": [ { "id": "iconShelter", "sfx": "pop", "t": -0.35, "from": "end", "gain": -9 } ] },
        { "id": "f_month", "who": "farmer", "text": "Every month.", "gap": 0.35,
          "cues": [ { "id": "calendar", "sfx": "flip", "t": 0.0, "gain": -8 } ] },
        { "id": "s_okay", "who": "sheepA", "text": "Oh, okay.", "gap": 0.7 },
        { "id": "s_food", "who": "sheepB", "text": "I like food!", "gap": 0.25,
          "cues": [ { "id": "heartB", "sfx": "heart", "t": -0.15, "from": "end", "gain": -10 } ] },
        { "id": "s_shelter", "who": "sheepC", "text": "And I like shelter!", "gap": 0.2,
          "cues": [ { "id": "heartC", "sfx": "heart", "t": -0.15, "from": "end", "gain": -10 } ] }
      ]
    },

    {
      "id": "smile", "lead": 0.3, "hold": 2.4, "music": "sneaky",
      "amb": [
        { "sfx": "rain", "from": "rainStart", "to": null, "gain": -17, "fade": 1.2 },
        { "sfx": "wind", "from": "rainStart", "to": null, "gain": -20, "fade": 1.5 }
      ],
      "lines": [
        { "id": "n_smiles", "who": "narrator", "text": "And then the farmer smiles,", "gap": 0,
          "cues": [ { "id": "grin", "sfx": "ting", "t": -0.25, "from": "end", "gain": -9 } ] },
        { "id": "n_locks", "who": "narrator", "text": "when the farmer locks the door,", "gap": 0.6,
          "cues": [ { "id": "doorSlam", "sfx": "door_slam", "t": 0.1, "from": "end", "gain": -4 },
                    { "id": "lockClick", "sfx": "lock", "t": 0.62, "from": "end", "gain": -8 } ] },
        { "id": "n_pesky", "who": "narrator", "text": "and the pesky sheep without the tokens get to sit outside in the elements,", "gap": 1.15,
          "cues": [ { "id": "rainStart", "t": -0.2 },
                    { "id": "thunder1", "sfx": "thunder", "t": 1.6, "gain": -8 } ] },
        { "id": "n_starve", "who": "narrator", "text": "and starve to death.", "gap": 0.3,
          "cues": [ { "id": "keel", "sfx": "thump", "t": 0.15, "from": "end", "gain": -9 },
                    { "id": "ghost", "sfx": "ghost", "t": 0.75, "from": "end", "gain": -12 } ] }
      ]
    },

    {
      "id": "herd", "lead": 0.4, "hold": 0.9, "music": "farm2",
      "lines": [
        { "id": "n_return", "who": "narrator", "text": "But in return, the sheep herd themselves.", "gap": 0 },
        { "id": "n_want", "who": "narrator", "text": "Because they want food and shelter.", "gap": 0.3 },
        { "id": "n_pen", "who": "narrator", "text": "So they willfully go into the pen at night,", "gap": 0.35,
          "cues": [ { "id": "gate1", "sfx": "turnstile", "t": 0.7, "gain": -12, "pan": -0.3 },
                    { "id": "gate2", "sfx": "turnstile", "t": 1.25, "gain": -12, "pan": -0.3 },
                    { "id": "gate3", "sfx": "turnstile", "t": 1.8, "gain": -12, "pan": -0.3 },
                    { "id": "gate4", "sfx": "turnstile", "t": 2.35, "gain": -12, "pan": -0.3 } ] },
        { "id": "n_feeders", "who": "narrator", "text": "and willfully go to the feeders,", "gap": 0.35,
          "cues": [ { "id": "feedCoin", "sfx": "coin_slot", "t": 0.45, "gain": -10 },
                    { "id": "hayDrop", "sfx": "hay", "t": 0.85, "gain": -10 },
                    { "id": "munch", "sfx": "munch", "t": 1.3, "gain": -12 } ] },
        { "id": "n_corral", "who": "narrator", "text": "without the farmer needing to corral them.", "gap": 0.3,
          "cues": [ { "id": "crookToss", "sfx": "whoosh", "t": -0.6, "from": "end", "gain": -12 },
                    { "id": "crookLand", "sfx": "clatter", "t": 0.05, "from": "end", "gain": -10 } ] },
        { "id": "n_gave", "who": "narrator", "text": "Because the farmer gave them money tokens.", "gap": 0.55,
          "cues": [ { "id": "tokenSign", "sfx": "shine", "t": -0.5, "from": "end", "gain": -10 } ] },
        { "id": "n_someshit", "who": "narrator", "text": "Or some shit.", "gap": 0.15 }
      ]
    },

    {
      "id": "brains", "lead": 0.35, "hold": 1.2, "music": "brains",
      "lines": [
        { "id": "n_cantuse", "who": "narrator", "text": "And of course, sheep can't use money,", "gap": 0,
          "cues": [ { "id": "bite", "sfx": "crunch", "t": -0.15, "from": "end", "gain": -9 } ] },
        { "id": "n_cognitive", "who": "narrator", "text": "'cause they don't have the cognitive ability to do so.", "gap": 0.35,
          "cues": [ { "id": "meterLow", "sfx": "error", "t": -0.35, "from": "end", "gain": -12 } ] },
        { "id": "n_once", "who": "narrator", "text": "But once you have the cognitive ability to understand money,", "gap": 0.55,
          "cues": [ { "id": "meterFill", "sfx": "powerup", "t": 0.3, "gain": -13 },
                    { "id": "morph", "sfx": "flash", "t": 0.0, "from": "end", "gain": -9 } ] },
        { "id": "n_control", "who": "narrator", "text": "then you can use that money to control the behavior of human beings.", "gap": 0.55 },
        { "id": "n_typeshit", "who": "narrator", "text": "Type shit.", "gap": 0.45 },
        { "id": "n_knowwhat", "who": "narrator", "text": "You know what I mean?", "gap": 0.25 }
      ]
    },

    {
      "id": "annoying", "lead": 0.45, "hold": 1.5, "music": "sneaky",
      "amb": [
        { "sfx": "rain", "from": "deniedRain", "to": "washStart", "gain": -19, "fade": 0.6 }
      ],
      "lines": [
        { "id": "n_itslike", "who": "narrator", "text": "And it's like, if you are the farmer,", "gap": 0 },
        { "id": "n_orsheep", "who": "narrator", "text": "or even some of the sheep,", "gap": 0.2,
          "cues": [ { "id": "richStep", "sfx": "bling", "t": 0.35, "gain": -11 } ] },
        { "id": "n_annoying", "who": "narrator", "text": "and some of the sheep are being very annoying, and you really don't like them,", "gap": 0.35,
          "cues": [ { "id": "annoyIn", "sfx": "bleat_loud", "t": 0.5, "gain": -9 },
                    { "id": "annoyBaa2", "sfx": "bleat_loud", "t": 2.3, "gain": -10 } ] },
        { "id": "n_problems", "who": "narrator", "text": "and they are causing a lot of problems, maybe even with your token supply,", "gap": 0.3,
          "cues": [ { "id": "jarBump", "sfx": "thump", "t": -1.5, "from": "end", "gain": -8 },
                    { "id": "jarSpill", "sfx": "coins_spill", "t": -1.2, "from": "end", "gain": -9 } ] },
        { "id": "n_risk", "who": "narrator", "text": "which puts your own shelter and food supply at risk.", "gap": 0.2,
          "cues": [ { "id": "riskStamp", "sfx": "stamp", "t": -0.45, "from": "end", "gain": -7 } ] },
        { "id": "n_allyou", "who": "narrator", "text": "All you need to do to get rid of those sheep,", "gap": 0.6,
          "cues": [ { "id": "remoteOut", "sfx": "pop", "t": -0.6, "from": "end", "gain": -10 } ] },
        { "id": "n_findaway", "who": "narrator", "text": "is find a way to get rid of their tokens.", "gap": 0.2,
          "cues": [ { "id": "buttonPress", "sfx": "click", "t": -0.55, "from": "end", "gain": -8 },
                    { "id": "tokenDrain", "sfx": "drain", "t": -0.45, "from": "end", "gain": -10 } ] },
        { "id": "n_letstarve", "who": "narrator", "text": "And then let them starve, or die in the elements.", "gap": 0.9,
          "cues": [ { "id": "deniedRain", "t": -0.35 },
                    { "id": "denied", "sfx": "denied", "t": 0.35, "gain": -11 } ] },
        { "id": "n_never", "who": "narrator", "text": "And you never had to get rid of them yourself.", "gap": 0.6,
          "cues": [ { "id": "washStart", "t": -0.2 },
                    { "id": "wash", "sfx": "splash", "t": 0.25, "gain": -11 } ] },
        { "id": "n_alldid", "who": "narrator", "text": "All you did, was get rid of their tokens.", "gap": 0.35,
          "cues": [ { "id": "whistle", "sfx": "whistle", "t": 0.15, "from": "end", "gain": -13 } ] }
      ]
    },

    {
      "id": "jesus", "lead": 0.25, "musicCut": true, "hold": 1.8, "music": "jesus",
      "cues": [ { "id": "scratch", "sfx": "scratch", "t": 0.0, "gain": -7 } ],
      "lines": [
        { "id": "n_lord", "who": "narrator", "text": "Oh Lord.", "gap": 0.35 },
        { "id": "n_imagining", "who": "narrator", "text": "Now I'm imagining, like, the farmer being like,", "gap": 0.6,
          "cues": [ { "id": "jesusGlow", "sfx": "sparkle", "t": -0.9, "gain": -12 } ] },
        { "id": "f_goaway", "who": "farmer", "text": "Well. That Jesus sheep will eventually just go away.", "gap": 0.45 },
        { "id": "f_nothing", "who": "farmer", "text": "Let's just not do anything.", "gap": 0.35,
          "cues": [ { "id": "hatOver", "t": 0.1, "from": "end" },
                    { "id": "snore", "sfx": "snore", "t": 0.6, "from": "end", "gain": -13 } ] }
      ]
    },

    {
      "id": "pharisees", "lead": 0.3, "hold": 0.5, "music": "tension",
      "lines": [
        { "id": "n_wealthier", "who": "narrator", "text": "But then some of the wealthier sheep, like the Pharisees,", "gap": 0,
          "cues": [ { "id": "pharIn", "sfx": "bling", "t": 0.55, "gain": -10 } ] },
        { "id": "n_demanding", "who": "narrator", "text": "are like, demanding the farmer do something to get rid of that Jesus sheep.", "gap": 0.15,
          "cues": [ { "id": "wake", "sfx": "startle", "t": -0.2, "from": "end", "gain": -10 } ] },
        { "id": "p_dosomething", "who": "phar1", "text": "Farmer! Do something about that Jesus sheep!", "gap": 0.3 },
        { "id": "n_lessmoney", "who": "narrator", "text": "Because the sheep that have less money than the Pharisee sheep keep asking for money,", "gap": 0.4 },
        { "id": "s_spare", "who": "poor", "text": "Spare a token?", "gap": 0.15 },
        { "id": "n_pissoff", "who": "narrator", "text": "and it's starting to really piss off the Pharisee sheep.", "gap": 0.3,
          "cues": [ { "id": "steam", "sfx": "steam", "t": -0.7, "from": "end", "gain": -13 } ] },
        { "id": "p_gone", "who": "phar1", "text": "We want that damn Jesus sheep gone!", "gap": 0.3 }
      ]
    },

    {
      "id": "sigh", "lead": 0.3, "hold": 0.6, "music": "tension",
      "lines": [
        { "id": "n_sighs", "who": "narrator", "text": "And then the farmer sighs, and goes,", "gap": 0,
          "cues": [ { "id": "sighSfx", "sfx": "sigh", "t": 0.1, "from": "end", "gain": -9 } ] },
        { "id": "f_notgood", "who": "farmer", "text": "I don't know if this is a good idea, you guys.", "gap": 1.55 }
      ]
    },

    {
      "id": "riot", "lead": 0.25, "musicEnd": "riotHit", "hold": 1.0, "music": "riot",
      "lines": [
        { "id": "n_slamming", "who": "narrator", "text": "And then the Pharisee sheep start slamming their hooves on the ground,", "gap": 0,
          "cues": [ { "id": "stomp1", "sfx": "stomp", "t": 1.45, "gain": -5 },
                    { "id": "stomp2", "sfx": "stomp", "t": 1.95, "gain": -5 },
                    { "id": "stomp3", "sfx": "stomp", "t": 2.45, "gain": -5 },
                    { "id": "stomp4", "sfx": "stomp", "t": 2.95, "gain": -5 },
                    { "id": "stomp5", "sfx": "stomp", "t": 3.45, "gain": -5 } ] },
        { "id": "n_bleating", "who": "narrator", "text": "bleating aggressively at the farmer,", "gap": 0.15,
          "cues": [ { "id": "angryBaas", "sfx": "bleat_angry", "t": 0.1, "gain": -10 } ] },
        { "id": "p_ourtokens", "who": "phar1", "text": "We're the ones who could lose our tokens if you don't do anything!", "gap": 0.45 },
        { "id": "p_riot", "who": "phar2", "text": "We'll riot!", "gap": 0.2,
          "cues": [ { "id": "crowdRise", "sfx": "crowd_roar", "t": 0.0, "gain": -12 } ] },
        { "id": "p_farm", "who": "phar1", "text": "We'll get all the sheep to take down this farm, once and for all!", "gap": 0.25,
          "cues": [ { "id": "riotHit", "sfx": "hit", "t": 0.05, "from": "end", "gain": -6 } ] }
      ]
    },

    {
      "id": "facepalm", "lead": 0.2, "hold": 1.1, "music": null,
      "lines": [
        { "id": "n_facepalm", "who": "narrator", "text": "And then the farmer face-palms, and goes,", "cap": "And then the farmer facepalms, and goes,", "gap": 0,
          "cues": [ { "id": "slap", "sfx": "slap", "t": 0.08, "from": "end", "gain": -5 } ] },
        { "id": "f_okay", "who": "farmer", "text": "Okay then.", "gap": 0.85 }
      ]
    },

    {
      "id": "cross", "lead": 0.6, "hold": 6.2, "music": null,
      "amb": [ { "sfx": "wind", "from": 0, "to": null, "gain": -19, "fade": 1.5 } ],
      "lines": [
        { "id": "n_crucify", "who": "narrator", "text": "And then they crucify the Jesus sheep.", "gap": 0,
          "cues": [ { "id": "bell", "sfx": "bell", "t": 0.7, "from": "end", "gain": -6 } ] }
      ]
    },

    {
      "id": "quiet", "lead": 1.0, "musicEnd": "finalCrack", "hold": 3.6, "music": "aftermath",
      "amb": [
        { "sfx": "crickets", "from": 0, "to": "airLine", "gain": -24, "fade": 2.0 },
        { "sfx": "wind", "from": "airLine", "to": null, "gain": -21, "fade": 3.0 }
      ],
      "lines": [
        { "id": "n_quiet", "who": "narrator", "text": "And then everything goes back to being quiet.", "gap": 0 },
        { "id": "n_air", "who": "narrator", "text": "But now there's this air of... something really bad happened.", "gap": 1.6,
          "cues": [ { "id": "airLine", "t": 0.0 },
                    { "id": "rumble", "sfx": "thunder_far", "t": 0.3, "from": "end", "gain": -10 } ] },
        { "id": "n_consequences", "who": "narrator", "text": "And what are going to be the consequences, later on?", "gap": 1.4,
          "cues": [ { "id": "finalCrack", "sfx": "thunder", "t": 1.3, "from": "end", "gain": -4 } ] }
      ]
    },

    {
      "id": "end", "lead": 0, "minDur": 5.5, "music": null,
      "cues": [ { "id": "endBoom", "sfx": "boom", "t": 0.35, "gain": -8 } ],
      "lines": []
    }
  ]
}
