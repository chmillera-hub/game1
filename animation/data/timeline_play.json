   "kind": "silent",
   "start": 304.333,
   "end": 307.133
  },
  "s20b02": {
   "scene": "s20",
   "kind": "line",
   "start": 307.133,
   "speaker": "NARRATOR",
   "text": "After that,",
   "inner": false,
   "audio": "audio/wav_play/s20b02.wav",
   "end": 308.172
  },
  "s20b03": {
   "scene": "s20",
   "kind": "line",
   "start": 309.072,
   "speaker": "NARRATOR",
   "text": "I may have shed a tear or two myself.",
   "inner": false,
