   ]
  },
  "s12b10": {
   "scene": "s12",
   "kind": "silent",
   "start": 180.418,
   "end": 182.818
  },
  "s12b11": {
   "scene": "s12",
   "kind": "line",
   "start": 182.818,
   "speaker": "NARRATOR",
   "text": "And the Void did not move. It stood there.",
   "inner": false,
   "audio": "audio/wav/s12b11.wav",
   "end": 187.943
  },
  "s13b01": {
   "scene": "s13",
   "kind": "silent",
   "start": 189.093,
   "end": 194.293,
   "sfx": [
    "rumble_low",
    "cloth_rustle"
   ]
  },
  "s13b02": {
   "scene": "s13",
   "kind": "line",
   "start": 194.293,
   "speaker": "FEAR",
   "text": "This is it.",
   "inner": true,
   "audio": "audio/wav/s13b02.wav",
   "end": 195.514,
   "sfx": [
    "heartbeat"
   ]
  },
  "s13b03": {
   "scene": "s13",
   "kind": "line",
   "start": 196.114,
   "speaker": "NARRATOR",
   "text": "My fear thought the Void had had enough of its complaining, and would destroy it.",
   "inner": false,
   "audio": "audio/wav/s13b03.wav",
   "end": 202.125,
   "sfx": [
    "heartbeat",
    "breath_shaky"
   ]
  },
  "s13b04": {
   "scene": "s13",
   "kind": "line",
   "start": 203.325,
   "speaker": "NARRATOR",
   "text": "But then, my fear felt a hand on its shoulder.",
   "inner": false,
   "audio": "audio/wav/s13b04.wav",
   "end": 207.32,
   "sfx": [
    "cloth_rustle"
   ]
  },
  "s13b05": {
   "scene": "s13",
   "kind": "silent",
   "start": 207.52,
   "end": 210.82
  },
  "s13b06": {
   "scene": "s13",
   "kind": "line",
   "start": 210.82,
   "speaker": "NARRATOR",
   "text": "And it looked up, into the face of the Void.",
   "inner": false,
   "audio": "audio/wav/s13b06.wav",
   "end": 214.402
  },
  "s14b01": {
   "scene": "s14",
   "kind": "silent",
   "start": 215.352,
   "end": 218.352,
   "sfx": [
    "shimmer",
    "twinkle"
   ]
  },
  "s14b02": {
   "scene": "s14",
   "kind": "line",
   "start": 218.352,
   "speaker": "NARRATOR",
   "text": "And instead of darkness, my fear saw the twinkling of lights.",
   "inner": false,
   "audio": "audio/wav/s14b02.wav",
   "end": 223.241,
   "sfx": [
    "twinkle"
   ]
  },
  "s14b03": {
   "scene": "s14",
   "kind": "line",
   "start": 223.741,
   "speaker": "NARRATOR",
   "text": "Like galaxies, and nebulae, and stars of the universe.",
   "inner": false,
   "audio": "audio/wav/s14b03.wav",
   "end": 227.919,
   "sfx": [
    "twinkle"
   ]
  },
  "s14b04": {
   "scene": "s14",
   "kind": "line",
   "start": 228.419,
   "speaker": "NARRATOR",
   "text": "The Void, filled with bits and pieces of meaning.",
   "inner": false,
   "audio": "audio/wav/s14b04.wav",
   "end": 231.808,
   "sfx": [
    "shimmer"
   ]
  },
  "s14b05": {
   "scene": "s14",
   "kind": "silent",
   "start": 232.208,
   "end": 236.608
  },
  "s14b06": {
   "scene": "s14",
   "kind": "line",
   "start": 236.608,
   "speaker": "NARRATOR",
   "text": "And for once, my fear wasn't afraid. It felt wonder, and amazement.",
   "inner": false,
   "audio": "audio/wav/s14b06.wav",
   "end": 244.156,
   "sfx": [
    "twinkle"
   ]
  },
  "s14b07": {
   "scene": "s14",
   "kind": "silent",
   "start": 244.656,
   "end": 246.256
  },
  "s14b08": {
   "scene": "s14",
   "kind": "line",
   "start": 246.256,
   "speaker": "FEAR",
   "text": "Why are you showing me this?",
   "inner": false,
   "audio": "audio/wav/s14b08.wav",
   "end": 248.209
  },
  "s14b09": {
   "scene": "s14",
   "kind": "silent",
   "start": 248.809,
   "end": 252.209,
   "sfx": [
    "cloth_rustle"
   ]
  },
  "s14b10": {
   "scene": "s14",
   "kind": "line",
   "start": 252.209,
   "speaker": "NARRATOR",
   "text": "And the Void stared into the screen of my consciousness.",
   "inner": false,
   "audio": "audio/wav/s14b10.wav",
   "end": 256.342
  },
  "s15b01": {
   "scene": "s15",
   "kind": "line",
   "start": 257.292,
   "speaker": "NARRATOR",
   "text": "My other emotions were looking back.",
   "inner": false,
   "audio": "audio/wav/s15b01.wav",
   "end": 260.059
  },
  "s15b02": {
   "scene": "s15",
   "kind": "silent",
   "start": 260.359,
   "end": 263.159
  },
  "s15b03": {
   "scene": "s15",
   "kind": "line",
   "start": 263.159,
   "speaker": "NARRATOR",
   "text": "They smiled, just for a moment, then went back to helping me.",
   "inner": false,
   "audio": "audio/wav/s15b03.wav",
   "end": 268.237,
   "sfx": [
    "console_beeps"
   ]
  },
  "s16b01": {
   "scene": "s16",
   "kind": "silent",
   "start": 269.187,
   "end": 271.187,
   "sfx": [
    "breath_shaky"
   ]
  },
  "s16b02": {
   "scene": "s16",
   "kind": "line",
   "start": 271.187,
   "speaker": "NARRATOR",
   "text": "Then my fear felt the gentle push of the Void.",
   "inner": false,
   "audio": "audio/wav/s16b02.wav",
   "end": 274.576,
   "sfx": [
    "cloth_rustle",
    "footsteps"
   ]
  },
  "s16b03": {
   "scene": "s16",
   "kind": "line",
   "start": 275.076,
   "speaker": "NARRATOR",
   "text": "The Void stood there, with galaxies twinkling in its dark facade.",
   "inner": false,
   "audio": "audio/wav/s16b03.wav",
   "end": 281.128,
   "sfx": [
    "twinkle"
   ]
  },
  "s16b04": {
   "scene": "s16",
   "kind": "silent",
   "start": 281.428,
   "end": 285.628
  },
  "s17b01": {
   "scene": "s17",
   "kind": "silent",
   "start": 286.078,
   "end": 288.478
  },
  "s17b02": {
   "scene": "s17",
   "kind": "silent",
   "start": 288.478,
   "end": 290.078
  },
  "s17b03": {
   "scene": "s17",
   "kind": "line",
   "start": 290.078,
   "speaker": "CONSCIOUSNESS",
   "text": "Fear.",
   "inner": false,
   "audio": "audio/wav/s17b03.wav",
   "end": 290.811
  },
  "s17b04": {
   "scene": "s17",
   "kind": "line",
   "start": 291.711,
   "speaker": "FEAR",
   "text": "Can I help?",
   "inner": false,
   "audio": "audio/wav/s17b04.wav",
   "end": 292.769
  },
  "s17b05": {
   "scene": "s17",
   "kind": "silent",
   "start": 293.169,
   "end": 296.769,
   "sfx": [
    "footsteps",
    "console_beeps"
   ]
  },
  "s18b01": {
   "scene": "s18",
   "kind": "silent",
   "start": 297.669,
   "end": 298.969,
   "sfx": [
    "rust_creak"
   ]
  },
  "s18b02": {
   "scene": "s18",
   "kind": "line",
   "start": 298.969,
   "speaker": "NARRATOR",
   "text": "The old cage had rusted, its gate hanging open.",
   "inner": false,
   "audio": "audio/wav/s18b02.wav",
   "end": 303.447
  },
  "s18b03": {
   "scene": "s18",
   "kind": "line",
   "start": 303.947,
   "speaker": "NARRATOR",
   "text": "But that was just a small detail.",
   "inner": false,
   "audio": "audio/wav/s18b03.wav",
   "end": 306.614
  },
  "s19b01": {
   "scene": "s19",
   "kind": "line",
   "start": 308.014,
   "speaker": "NARRATOR",
   "text": "Because the scene changed, to my emotions at the console.",
   "inner": false,
   "audio": "audio/wav/s19b01.wav",
   "end": 312.281,
   "sfx": [
    "console_beeps"
   ]
  },
  "s19b02": {
   "scene": "s19",
   "kind": "line",
   "start": 312.681,
   "speaker": "NARRATOR",
   "text": "And the Void, standing in the background.",
   "inner": false,
   "audio": "audio/wav/s19b02.wav",
   "end": 315.337
  },
  "s19b03": {
   "scene": "s19",
   "kind": "line",
   "start": 315.737,
   "speaker": "NARRATOR",
   "text": "I could barely see that rusty cage anymore, in the back of my mind.",
   "inner": false,
   "audio": "audio/wav/s19b03.wav",
   "end": 322.014,
   "sfx": [
    "twinkle"
   ]
  },
  "s20b01": {
   "scene": "s20",
   "kind": "silent",
   "start": 323.714,
   "end": 326.514
  },
  "s20b02": {
   "scene": "s20",
   "kind": "line",
   "start": 326.514,
   "speaker": "NARRATOR",
   "text": "After that,",
   "inner": false,
   "audio": "audio/wav/s20b02.wav",
   "end": 327.703
  },
  "s20b03": {
   "scene": "s20",
   "kind": "line",
   "start": 328.603,
   "speaker": "NARRATOR",
   "text": "I may have shed a tear or two myself.",
   "inner": false,
   "audio": "audio/wav/s20b03.wav",
   "end": 331.27
  },
  "s20b04": {
   "scene": "s20",
   "kind": "silent",
   "start": 332.07,
   "end": 336.07,
   "sfx": [
    "lamp_click",
    "twinkle"
   ]
  }
