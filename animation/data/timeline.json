  },
  "s12b10": {
   "scene": "s12",
   "kind": "silent",
   "start": 182.118,
   "end": 184.518
  },
  "s12b11": {
   "scene": "s12",
   "kind": "line",
   "start": 184.518,
   "speaker": "NARRATOR",
   "text": "And the Void did not move. It stood there.",
   "inner": false,
   "audio": "audio/wav/s12b11.wav",
   "end": 189.622
  },
  "s13b01": {
   "scene": "s13",
   "kind": "silent",
   "start": 190.772,
   "end": 195.972,
   "sfx": [
    "rumble_low",
    "cloth_rustle"
   ]
  },
  "s13b02": {
   "scene": "s13",
   "kind": "line",
   "start": 195.972,
   "speaker": "FEAR",
   "text": "This is it.",
   "inner": true,
   "audio": "audio/wav/s13b02.wav",
   "end": 197.171,
   "sfx": [
    "heartbeat"
   ]
  },
  "s13b03": {
   "scene": "s13",
   "kind": "line",
   "start": 197.771,
   "speaker": "NARRATOR",
   "text": "My fear thought the Void had had enough of its complaining, and would destroy it.",
   "inner": false,
   "audio": "audio/wav/s13b03.wav",
   "end": 203.768,
   "sfx": [
    "heartbeat",
    "breath_shaky"
   ]
  },
  "s13b04": {
   "scene": "s13",
   "kind": "line",
   "start": 204.968,
   "speaker": "NARRATOR",
   "text": "But then, my fear felt a hand on its shoulder.",
   "inner": false,
   "audio": "audio/wav/s13b04.wav",
   "end": 208.942,
   "sfx": [
    "cloth_rustle"
   ]
  },
  "s13b05": {
   "scene": "s13",
   "kind": "silent",
   "start": 209.142,
   "end": 212.442
  },
  "s13b06": {
   "scene": "s13",
   "kind": "line",
   "start": 212.442,
   "speaker": "NARRATOR",
   "text": "And it looked up, into the face of the Void.",
   "inner": false,
   "audio": "audio/wav/s13b06.wav",
   "end": 216.01
  },
  "s14b01": {
   "scene": "s14",
   "kind": "silent",
   "start": 216.96,
   "end": 219.96,
   "sfx": [
    "shimmer",
    "twinkle"
   ]
  },
  "s14b02": {
   "scene": "s14",
   "kind": "line",
   "start": 219.96,
   "speaker": "NARRATOR",
   "text": "And instead of darkness, my fear saw the twinkling of lights.",
   "inner": false,
   "audio": "audio/wav/s14b02.wav",
   "end": 224.836,
   "sfx": [
    "twinkle"
   ]
  },
  "s14b03": {
   "scene": "s14",
   "kind": "line",
   "start": 225.336,
   "speaker": "NARRATOR",
   "text": "Like galaxies, and nebulae, and stars of the universe.",
   "inner": false,
   "audio": "audio/wav/s14b03.wav",
   "end": 229.492,
   "sfx": [
    "twinkle"
   ]
  },
  "s14b04": {
   "scene": "s14",
   "kind": "line",
   "start": 229.992,
   "speaker": "NARRATOR",
   "text": "The Void, filled with bits and pieces of meaning.",
   "inner": false,
   "audio": "audio/wav/s14b04.wav",
   "end": 233.367,
   "sfx": [
    "shimmer"
   ]
  },
  "s14b05": {
   "scene": "s14",
   "kind": "silent",
   "start": 233.767,
   "end": 238.167
  },
  "s14b06": {
   "scene": "s14",
   "kind": "line",
   "start": 238.167,
   "speaker": "NARRATOR",
   "text": "And for once, my fear wasn't afraid. It felt wonder, and amazement.",
   "inner": false,
   "audio": "audio/wav/s14b06.wav",
   "end": 245.695,
   "sfx": [
    "twinkle"
   ]
  },
  "s14b07": {
   "scene": "s14",
   "kind": "silent",
   "start": 246.195,
   "end": 248.795
  },
  "s14b08": {
   "scene": "s14",
   "kind": "line",
   "start": 248.795,
   "speaker": "FEAR",
   "text": "Why are you showing me this?",
   "inner": false,
   "audio": "audio/wav/s14b08.wav",
   "end": 250.727
  },
  "s14b09": {
   "scene": "s14",
   "kind": "silent",
   "start": 251.327,
   "end": 255.527,
   "sfx": [
    "cloth_rustle"
   ]
  },
  "s14b10": {
   "scene": "s14",
   "kind": "line",
   "start": 255.527,
   "speaker": "NARRATOR",
   "text": "And the Void stared into the screen of my consciousness.",
   "inner": false,
   "audio": "audio/wav/s14b10.wav",
   "end": 259.644
  },
  "s15b01": {
   "scene": "s15",
   "kind": "line",
   "start": 260.594,
   "speaker": "NARRATOR",
   "text": "My other emotions were looking back.",
   "inner": false,
   "audio": "audio/wav/s15b01.wav",
   "end": 263.343
  },
  "s15b02": {
   "scene": "s15",
   "kind": "silent",
   "start": 263.643,
   "end": 267.643
  },
  "s15b03": {
   "scene": "s15",
   "kind": "line",
   "start": 267.643,
   "speaker": "NARRATOR",
   "text": "They smiled, just for a moment, then went back to helping me.",
   "inner": false,
   "audio": "audio/wav/s15b03.wav",
   "end": 272.71,
   "sfx": [
    "console_beeps"
   ]
  },
  "s16b01": {
   "scene": "s16",
   "kind": "silent",
   "start": 273.66,
   "end": 275.66,
   "sfx": [
    "breath_shaky"
   ]
  },
  "s16b02": {
   "scene": "s16",
   "kind": "line",
   "start": 275.66,
   "speaker": "NARRATOR",
   "text": "Then my fear felt the gentle push of the Void.",
   "inner": false,
   "audio": "audio/wav/s16b02.wav",
   "end": 279.033,
   "sfx": [
    "cloth_rustle",
    "footsteps"
   ]
  },
  "s16b03": {
   "scene": "s16",
   "kind": "line",
   "start": 279.533,
   "speaker": "NARRATOR",
   "text": "The Void stood there, with galaxies twinkling in its dark facade.",
   "inner": false,
   "audio": "audio/wav/s16b03.wav",
   "end": 285.571,
   "sfx": [
    "twinkle"
   ]
  },
  "s16b04": {
   "scene": "s16",
   "kind": "silent",
   "start": 285.871,
   "end": 290.071
  },
  "s17b01": {
   "scene": "s17",
   "kind": "silent",
   "start": 290.521,
   "end": 292.921
  },
  "s17b02": {
   "scene": "s17",
   "kind": "silent",
   "start": 292.921,
   "end": 294.521
  },
  "s17b03": {
   "scene": "s17",
   "kind": "line",
   "start": 294.521,
   "speaker": "CONSCIOUSNESS",
   "text": "Fear.",
   "inner": false,
   "audio": "audio/wav/s17b03.wav",
   "end": 295.123
  },
  "s17b04": {
   "scene": "s17",
   "kind": "line",
   "start": 296.023,
   "speaker": "FEAR",
   "text": "Can I help?",
   "inner": false,
   "audio": "audio/wav/s17b04.wav",
   "end": 297.065
  },
  "s17b05": {
   "scene": "s17",
   "kind": "silent",
   "start": 297.465,
   "end": 302.465,
   "sfx": [
    "footsteps",
    "console_beeps"
   ]
  },
  "s18b01": {
   "scene": "s18",
   "kind": "silent",
   "start": 303.365,
   "end": 304.665,
   "sfx": [
    "rust_creak"
   ]
  },
  "s18b02": {
   "scene": "s18",
   "kind": "line",
   "start": 304.665,
   "speaker": "NARRATOR",
   "text": "The old cage had rusted, its gate hanging open.",
   "inner": false,
   "audio": "audio/wav/s18b02.wav",
   "end": 309.125
  },
  "s18b03": {
   "scene": "s18",
   "kind": "line",
   "start": 309.625,
   "speaker": "NARRATOR",
   "text": "But that was just a small detail.",
   "inner": false,
   "audio": "audio/wav/s18b03.wav",
   "end": 312.275
  },
  "s19b01": {
   "scene": "s19",
   "kind": "line",
   "start": 313.675,
   "speaker": "NARRATOR",
   "text": "Because the scene changed, to my emotions at the console.",
   "inner": false,
   "audio": "audio/wav/s19b01.wav",
   "end": 317.922,
   "sfx": [
    "console_beeps"
   ]
  },
  "s19b02": {
   "scene": "s19",
   "kind": "line",
   "start": 318.322,
   "speaker": "NARRATOR",
   "text": "And the Void, standing in the background.",
   "inner": false,
   "audio": "audio/wav/s19b02.wav",
   "end": 320.958
  },
  "s19b03": {
   "scene": "s19",
   "kind": "line",
   "start": 321.358,
   "speaker": "NARRATOR",
   "text": "I could barely see that rusty cage anymore, in the back of my mind.",
   "inner": false,
   "audio": "audio/wav/s19b03.wav",
   "end": 327.618,
   "sfx": [
    "twinkle"
   ]
  },
  "s20b01": {
   "scene": "s20",
   "kind": "silent",
   "start": 329.318,
   "end": 332.118
  },
  "s20b02": {
   "scene": "s20",
   "kind": "line",
   "start": 332.118,
   "speaker": "NARRATOR",
   "text": "After that,",
   "inner": false,
   "audio": "audio/wav/s20b02.wav",
   "end": 333.292
  },
  "s20b03": {
   "scene": "s20",
   "kind": "line",
   "start": 334.192,
   "speaker": "NARRATOR",
   "text": "I may have shed a tear or two myself.",
   "inner": false,
   "audio": "audio/wav/s20b03.wav",
   "end": 336.835
  },
  "s20b04": {
   "scene": "s20",
   "kind": "silent",
   "start": 337.635,
   "end": 341.635,
   "sfx": [
    "lamp_click",
    "twinkle"
   ]
  }
