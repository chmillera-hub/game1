   "kind": "line",
   "start": 140.107,
   "speaker": "NARRATOR",
   "text": "And Jesus nods, just slightly.",
   "end": 142.282
  },
  "s08b01": {
   "scene": "s08",
   "kind": "silent",
   "start": 143.232,
   "end": 145.632,
   "sfx": [
    "footsteps_soft",
    "cloth_rustle"
   ]
  },
  "s08b02": {
   "scene": "s08",
   "kind": "line",
   "start": 145.632,
   "speaker": "JESUS",
   "text": "It's okay.",
   "end": 146.732
  },
  "s08b03": {
   "scene": "s08",
   "kind": "line",
   "start": 147.232,
   "speaker": "JESUS",
   "text": "You don't have to talk to the void.",
   "end": 150.732
  },
  "s08b04": {
   "scene": "s08",
   "kind": "silent",
   "start": 151.332,
   "end": 152.332
  },
  "s08b05": {
   "scene": "s08",
   "kind": "line",
   "start": 152.332,
   "speaker": "JESUS",
   "text": "But what about... you talk to me?",
   "end": 155.432
  },
  "s08b06": {
   "scene": "s08",
   "kind": "silent",
   "start": 156.032,
   "end": 156.932
  },
  "s08b07": {
   "scene": "s08",
   "kind": "line",
   "start": 156.932,
   "speaker": "JESUS",
   "text": "And it doesn't have to be about the void.",
   "end": 160.832
  },
  "s08b08": {
   "scene": "s08",
   "kind": "line",
   "start": 161.132,
   "speaker": "JESUS",
   "text": "It can be about you.",
   "end": 163.432
  },
  "s08b09": {
   "scene": "s08",
   "kind": "line",
   "start": 163.732,
   "speaker": "JESUS",
   "text": "And your emotions, that you are feeling.",
   "end": 166.832
  },
  "s08b10": {
   "scene": "s08",
   "kind": "silent",
   "start": 167.032,
   "end": 169.032
  },
  "s08b11": {
   "scene": "s08",
   "kind": "line",
   "start": 169.032,
   "speaker": "JESUS",
   "text": "Because I want to talk to you more about emotions,",
   "end": 173.332
  },
  "s08b12": {
   "scene": "s08",
   "kind": "line",
   "start": 173.432,
   "speaker": "JESUS",
   "text": "because that's meaningful to me!",
   "end": 175.732,
   "sfx": [
    "shimmer"
   ]
  },
  "s08b13": {
   "scene": "s08",
   "kind": "line",
   "start": 176.332,
   "speaker": "JESUS",
   "text": "How does that sound?",
   "end": 178.232
  },
  "s08b14": {
   "scene": "s08",
   "kind": "silent",
   "start": 178.632,
   "end": 181.632
  },
  "s09b01": {
   "scene": "s09",
   "kind": "line",
   "start": 181.982,
   "speaker": "NARRATOR",
   "text": "And then the Twitter user gets up,",
   "end": 184.907,
   "sfx": [
    "cloth_rustle"
   ]
  },
  "s09b02": {
   "scene": "s09",
   "kind": "line",
   "start": 184.907,
   "speaker": "NARRATOR",
   "text": "and storms off,",
   "end": 186.332,
   "sfx": [
    "footsteps_stomp"
   ]
  },
  "s09b03": {
   "scene": "s09",
   "kind": "line",
   "start": 186.332,
   "speaker": "NARRATOR",
   "text": "and blocks Jesus on Twitter.",
   "end": 188.507,
   "sfx": [
    "phone_tap",
    "block_thunk"
   ]
  },
  "s09b04": {
   "scene": "s09",
   "kind": "silent",
   "start": 189.007,
   "end": 190.607,
   "sfx": [
    "notification_ding"
   ]
  },
  "s09b05": {
   "scene": "s09",
   "kind": "line",
   "start": 190.607,
   "speaker": "NARRATOR",
   "text": "For talking about the void too intensely.",
   "end": 193.532
  },
  "s09b06": {
   "scene": "s09",
   "kind": "vocal",
   "start": 193.732,
   "speaker": "NARRATOR",
   "vocal": "laugh_soft",
   "caption": "(laughs)",
   "end": 194.932
  },
  "s10b01": {
   "scene": "s10",
   "kind": "line",
   "start": 195.582,
   "speaker": "NARRATOR",
   "text": "So Jesus looks back at the void,",
   "end": 198.507,
   "sfx": [
    "footsteps_soft"
   ]
  },
  "s10b02": {
   "scene": "s10",
   "kind": "line",
   "start": 198.507,
   "speaker": "NARRATOR",
   "text": "and shrugs.",
   "end": 199.557
  },
  "s10b03": {
   "scene": "s10",
   "kind": "line",
   "start": 200.157,
   "speaker": "NARRATOR",
   "text": "And the void pats him on the shoulder,",
   "end": 203.457,
   "sfx": [
    "pat_pat"
   ]
  },
  "s10b04": {
   "scene": "s10",
   "kind": "line",
   "start": 203.457,
   "speaker": "NARRATOR",
   "text": "and gives a sad little smile.",
   "end": 206.007
  },
  "s10b05": {
   "scene": "s10",
   "kind": "silent",
   "start": 206.507,
   "end": 208.707,
   "sfx": [
    "twinkle"
   ]
  },
  "s11b01": {
   "scene": "s11",
   "kind": "line",
   "start": 209.057,
   "speaker": "NARRATOR",
   "text": "And Jesus puts his arm around the void,",
   "end": 212.357,
   "sfx": [
    "cloth_rustle"
   ]
  },
  "s11b02": {
   "scene": "s11",
   "kind": "line",
   "start": 212.357,
   "speaker": "NARRATOR",
   "text": "and they both walk off into the horizon,",
   "end": 215.657,
   "sfx": [
    "footsteps_soft",
    "wind_soft"
   ]
  },
  "s11b03": {
   "scene": "s11",
   "kind": "line",
   "start": 215.657,
   "speaker": "NARRATOR",
   "text": "Jesus smiling a bit, telling the void more dumb jokes...",
   "end": 219.707
  },
  "s11b04": {
   "scene": "s11",
   "kind": "line",
   "start": 219.707,
   "speaker": "JESUS",
   "text": "So the neutron asks, 'How much for a drink?'",
   "end": 224.007
  },
  "s11b05": {
   "scene": "s11",
   "kind": "line",
   "start": 224.207,
   "speaker": "JESUS",
   "text": "And the bartender says, 'For you? No charge.'",
   "end": 228.107
  },
  "s11b06": {
   "scene": "s11",
   "kind": "vocal",
   "start": 228.207,
   "speaker": "VOID",
   "vocal": "giggle",
   "caption": null,
   "end": 229.807,
   "sfx": [
    "star_pop",
    "twinkle"
   ]
  },
  "s11b07": {
   "scene": "s11",
   "kind": "line",
   "start": 230.107,
   "speaker": "NARRATOR",
   "text": "as the void is slightly giggling, in the distance...",
   "end": 233.782,
   "sfx": [
    "twinkle"
   ]
  },
  "s11b08": {
   "scene": "s11",
   "kind": "vocal",
   "start": 230.107,
   "speaker": "VOID",
   "vocal": "giggle",
   "caption": null,
   "end": 231.507
  },
  "s11b09": {
   "scene": "s11",
   "kind": "silent",
   "start": 233.782,
   "end": 237.382,
   "sfx": [
    "wind_soft",
    "twinkle"
   ]
  },
  "s12b01": {
   "scene": "s12",
   "kind": "vocal",
   "start": 238.082,
   "speaker": "NARRATOR",
   "vocal": "laugh_soft",
   "caption": "(laughs)",
   "end": 239.382,
   "sfx": [
    "shimmer"
   ]
  },
  "s12b02": {
   "scene": "s12",
   "kind": "line",
   "start": 239.382,
   "speaker": "NARRATOR",
   "text": "Okay. Bonus scene.",
   "end": 240.807,
   "sfx": [
    "rumble_low"
   ]
  },
  "s12b03": {
   "scene": "s12",
   "kind": "line",
   "start": 241.407,
   "speaker": "NARRATOR",
   "text": "Now I'm imagining, when the void opened up the cage to my fear,",
   "end": 246.582,
   "sfx": [
    "lock_click",
    "cage_creak"
   ]
  },
  "s12b04": {
   "scene": "s12",
   "kind": "silent",
   "start": 246.782,
   "end": 249.182,
   "sfx": [
    "twinkle"
   ]
  },
  "s12b05": {
   "scene": "s12",
   "kind": "line",
   "start": 249.182,
   "speaker": "NARRATOR",
   "text": "that the depression magician was lurking,",
   "end": 251.732,
   "sfx": [
    "shimmer"
   ]
  },
  "s12b06": {
   "scene": "s12",
   "kind": "line",
   "start": 251.732,
   "speaker": "NARRATOR",
   "text": "right behind the big body of the void,",
   "end": 255.032
  },
  "s12b07": {
   "scene": "s12",
   "kind": "line",
   "start": 255.232,
   "speaker": "NARRATOR",
   "text": "with its dagger,",
   "end": 256.657,
   "sfx": [
    "dagger_shing"
   ]
  },
  "s12b08": {
   "scene": "s12",
   "kind": "line",
   "start": 256.657,
   "speaker": "NARRATOR",
   "text": "and numbing dust, ready.",
   "end": 258.457,
   "sfx": [
    "dust_sparkle"
   ]
  },
  "s12b09": {
   "scene": "s12",
   "kind": "line",
   "start": 258.757,
   "speaker": "NARRATOR",
   "text": "And the magician is, like, licking its lips, going,",
   "end": 262.432
  },
  "s12b10": {
   "scene": "s12",
   "kind": "line",
   "start": 262.532,
   "speaker": "MAGICIAN",
   "text": "Fear looks very juicy...",
   "end": 264.546
  },
  "s12b11": {
   "scene": "s12",
   "kind": "line",
   "start": 264.946,
   "speaker": "MAGICIAN",
   "text": "Can't wait to knock Fear out.",
   "end": 267.818
  },
  "s13b01": {
   "scene": "s13",
   "kind": "line",
   "start": 268.668,
   "speaker": "NARRATOR",
   "text": "And then the void can see the magician,",
   "end": 271.968
  },
  "s13b02": {
   "scene": "s13",
   "kind": "line",
   "start": 271.968,
   "speaker": "NARRATOR",
   "text": "in the corner of its peripheral vision.",
   "end": 274.893
  },
  "s13b03": {
   "scene": "s13",
   "kind": "silent",
   "start": 275.193,
   "end": 277.593
  },
  "s13b04": {
   "scene": "s13",
   "kind": "line",
   "start": 277.593,
   "speaker": "NARRATOR",
   "text": "And instead of shouting,",
   "end": 279.393
  },
  "s13b05": {
   "scene": "s13",
   "kind": "line",
   "start": 279.393,
   "speaker": "NARRATOR",
   "text": "or making it obvious to my fear,",
   "end": 282.318,
   "sfx": [
    "twinkle"
   ]
  },
  "s13b06": {
   "scene": "s13",
   "kind": "line",
   "start": 282.318,
   "speaker": "NARRATOR",
   "text": "that there's a creepy depression magician trying to stab it,",
   "end": 286.368,
   "sfx": [
    "footsteps_soft"
   ]
  },
  "s13b07": {
   "scene": "s13",
   "kind": "line",
   "start": 286.368,
   "speaker": "NARRATOR",
   "text": "the void just...",
   "end": 287.793
  },
  "s13b08": {
   "scene": "s13",
   "kind": "line",
   "start": 288.693,
   "speaker": "NARRATOR",
   "text": "kicks the magician in the chest with its fat leg.",
   "end": 292.743,
   "sfx": [
    "kick_thump"
   ]
  },
  "s13b09": {
   "scene": "s13",
   "kind": "line",
   "start": 292.943,
   "speaker": "NARRATOR",
   "text": "And the depression magician goes flying,",
   "end": 295.493,
   "sfx": [
    "whoosh_fly"
   ]
  },
  "s13b10": {
   "scene": "s13",
   "kind": "line",
   "start": 295.493,
   "speaker": "NARRATOR",
   "text": "and knocks over some buckets and cleaning supplies,",
   "end": 298.793,
   "sfx": [
    "crash_buckets",
    "mop_clatter"
   ]
  },
  "s13b11": {
   "scene": "s13",
   "kind": "line",
   "start": 298.793,
   "speaker": "NARRATOR",
   "text": "like an old-timey cartoon.",
   "end": 300.968,
   "sfx": [
    "bucket_bonk",
    "cartoon_birdies"
   ]
  },
  "s13b12": {
   "scene": "s13",
   "kind": "silent",
   "start": 301.168,
   "end": 303.768,
   "sfx": [
    "dagger_shing",
    "dust_sparkle",
    "mop_clatter"
   ]
  },
  "s13b13": {
   "scene": "s13",
   "kind": "line",
   "start": 303.768,
   "speaker": "MAGICIAN",
   "text": "...ow.",
   "end": 304.496,
   "sfx": [
    "cartoon_birdies"
   ]
  },
  "s14b01": {
   "scene": "s14",
   "kind": "silent",
   "start": 305.446,
   "end": 306.246
  },
  "s14b02": {
   "scene": "s14",
   "kind": "line",
   "start": 306.246,
   "speaker": "FEAR",
   "text": "What's that noise?",
   "end": 307.746
  },
  "s14b03": {
   "scene": "s14",
   "kind": "line",
   "start": 308.146,
   "speaker": "NARRATOR",
   "text": "And the void just shrugs.",
   "end": 310.321,
   "sfx": [
    "cloth_rustle"
   ]
  },
  "s14b04": {
   "scene": "s14",
   "kind": "silent",
   "start": 310.621,
   "end": 313.021,
   "sfx": [
    "galaxy_whirl"
   ]
  },
  "s15b01": {
   "scene": "s15",
   "kind": "line",
   "start": 313.371,
   "speaker": "NARRATOR",
   "text": "And goes right on showing my fear the galaxies,",
   "end": 317.046,
   "sfx": [
    "galaxy_whirl",
    "shimmer"
   ]
  },
  "s15b02": {
   "scene": "s15",
   "kind": "line",
   "start": 317.046,
   "speaker": "NARRATOR",
   "text": "and the nebulae.",
   "end": 318.471,
   "sfx": [
    "nebula_swell"
   ]
  },
  "s15b03": {
   "scene": "s15",
   "kind": "silent",
   "start": 318.871,
   "end": 322.271,
   "sfx": [
    "twinkle"
   ]
  },
  "s15b04": {
   "scene": "s15",
   "kind": "line",
   "start": 322.271,
   "speaker": "FEAR",
   "text": "Why are you showing me this?",
   "end": 324.971
  },
  "s15b05": {
   "scene": "s15",
   "kind": "silent",
   "start": 325.471,
   "end": 328.071,
   "sfx": [
    "cloth_rustle"
   ]
  },
  "s15b06": {
   "scene": "s15",
   "kind": "line",
   "start": 328.071,
   "speaker": "NARRATOR",
   "text": "To distract my fear,",
   "end": 329.871
  },
  "s15b07": {
   "scene": "s15",
   "kind": "line",
   "start": 329.871,
   "speaker": "NARRATOR",
   "text": "from the fact that the void had to kick the depression magician in the chest,",
   "end": 335.796,
   "sfx": [
    "cartoon_birdies"
   ]
  },
  "s15b08": {
   "scene": "s15",
   "kind": "line",
   "start": 335.796,
   "speaker": "NARRATOR",
   "text": "to get it to go away,",
   "end": 338.346
  },
  "s15b09": {
   "scene": "s15",
   "kind": "line",
   "start": 338.646,
   "speaker": "NARRATOR",
   "text": "so that the void could have a moment...",
   "end": 341.946
  },
  "s15b10": {
   "scene": "s15",
   "kind": "line",
   "start": 342.346,
   "speaker": "NARRATOR",
   "text": "with my fear.",
   "end": 343.771,
   "sfx": [
    "twinkle"
   ]
  },
  "s15b11": {
   "scene": "s15",
   "kind": "silent",
   "start": 344.771,
   "end": 347.771,
