+"""report.md の候補表: 行数の上限を超えた分は件数だけを示すこと."""
+
+from __future__ import annotations
+
+from security_checker.models.candidate import Candidate
+from security_checker.report.markdown import MAX_CANDIDATE_ROWS, _candidates
+from tests.factories import make_candidate, make_report
+
+
+def _many(count: int) -> list[Candidate]:
+    return [make_candidate(f"c{index}", line=index + 1) for index in range(count)]
+
+
+def _rows(lines: list[str]) -> list[str]:
+    """表の本体の行 (見出しと区切りを除く)."""
+    return [line for line in lines if line.startswith("| ") and "重大度" not in line]
+
+
+def test_rows_past_the_limit_are_counted_not_listed() -> None:
+    lines = _candidates(make_report(_many(MAX_CANDIDATE_ROWS + 3)))
+
+    assert len(_rows(lines)) == MAX_CANDIDATE_ROWS
+    assert "_ほか 3 件は `report.json` を参照_" in lines
+
+
+def test_exactly_the_limit_lists_every_row_without_the_note() -> None:
+    """境界. ちょうど上限の件数なら注記は出ない."""
+    lines = _candidates(make_report(_many(MAX_CANDIDATE_ROWS)))
+
+    assert len(_rows(lines)) == MAX_CANDIDATE_ROWS
+    assert not any("report.json" in line for line in lines)
