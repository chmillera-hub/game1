+"""Severity の比較: Severity 以外との < は NotImplemented を返し、TypeError になること."""
+
+from __future__ import annotations
+
+import pytest
+
+from security_checker.models.enums import Severity
+
+
+@pytest.mark.parametrize("other", [3, "high", None, 2.5])
+def test_less_than_with_another_type_is_not_implemented(other: object) -> None:
+    assert Severity.HIGH.__lt__(other) is NotImplemented
+
+
+def test_less_than_with_an_int_raises_type_error() -> None:
+    with pytest.raises(TypeError):
+        _ = Severity.HIGH < 3  # type: ignore[operator]
+
+
+def test_less_than_between_severities_follows_the_order() -> None:
+    """対になるケース. Severity どうしは深刻さの順で比べる."""
+    assert Severity.LOW < Severity.HIGH
+    assert not (Severity.HIGH < Severity.HIGH)
