+def archive_order(path: Path, data: dict) -> tuple:
+    """Sort key that puts archived roasts in the order they were written.
+
+    verdict.py names archives roast-<date>.json, then roast-<date>-2.json,
+    roast-<date>-3.json for later rounds on the same day. A plain name sort
+    gets that wrong ("-2.json" sorts before ".json"), so order by the roast's
+    own date and then by the round number in the file name.
+    """
+    date = str(data.get("date") or "undated")
+    rest = path.stem[len(f"roast-{date}"):] if path.stem.startswith(f"roast-{date}") else ""
+    round_no = int(rest[1:]) if rest[:1] == "-" and rest[1:].isdigit() else 1
+    return (date != "undated", date, round_no, path.name)
+
+
+def pick_baseline(history: str, which: str = "latest") -> Path:
+    """Pick the roast to compare against from a roast/history/ folder.
+
+    "latest" is the most recent archived roast (the previous round), "first"
+    is the oldest one. Files that are not roast.json files are ignored.
+    """
+    found = []
+    for path in Path(history).glob("*.json"):
+        try:
+            found.append((archive_order(path, load(str(path))), path))
+        except (OSError, ValueError):
+            continue
+    if not found:
+        raise ValueError(f"{history} holds no archived roast.json to compare against")
+    found.sort()
+    return found[0][1] if which == "first" else found[-1][1]
+
+
