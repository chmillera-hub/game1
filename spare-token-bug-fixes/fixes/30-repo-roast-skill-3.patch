+class HistoryBaselineTests(unittest.TestCase):
+    """With three rounds archived, the default baseline is the round before, not round one."""
+
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.t = Path(self._tmp.name)
+        self.history = self.t / "history"
+        self.history.mkdir()
+        scores = {"security": 3.0}
+        # Round two and three were archived on the same day: verdict.py names
+        # the later one with a -2 suffix, which a plain name sort puts first.
+        rounds = [("roast-2026-11-01.json", 3.0, "2026-11-01"),
+                  ("roast-2026-11-05.json", 5.0, "2026-11-05"),
+                  ("roast-2026-11-05-2.json", 6.0, "2026-11-05")]
+        for name, overall, date in rounds:
+            (self.history / name).write_text(json.dumps(roast(overall, scores, date=date)), encoding="utf-8")
+        (self.history / "notes.json").write_text("{}", encoding="utf-8")
+        self.after = self.t / "roast.json"
+        self.after.write_text(json.dumps(roast(7.0, scores, date="2026-11-09")), encoding="utf-8")
+
+    def run_delta(self, *extra):
+        buf = io.StringIO()
+        with redirect_stdout(buf):
+            code = delta.main(["--history", str(self.history), "--after", str(self.after), "--json", *extra])
+        return code, buf.getvalue()
+
+    def test_default_baseline_is_the_most_recent_round(self):
+        self.assertEqual(delta.pick_baseline(str(self.history)).name, "roast-2026-11-05-2.json")
+        code, out = self.run_delta()
+        self.assertEqual(code, 0)
+        c = json.loads(out)
+        self.assertEqual(c["overall_before"], 6.0)
+        self.assertEqual(c["overall_delta"], 1.0)
+
+    def test_baseline_first_compares_since_day_one(self):
+        self.assertEqual(delta.pick_baseline(str(self.history), "first").name, "roast-2026-11-01.json")
+        code, out = self.run_delta("--baseline", "first")
+        self.assertEqual(code, 0)
+        self.assertEqual(json.loads(out)["overall_delta"], 4.0)
+
+    def test_empty_history_is_an_error(self):
+        empty = self.t / "empty"
+        empty.mkdir()
+        with redirect_stdout(io.StringIO()):
+            code = delta.main(["--history", str(empty), "--after", str(self.after)])
+        self.assertEqual(code, 2)
+
+
 if __name__ == "__main__":
     unittest.main()
